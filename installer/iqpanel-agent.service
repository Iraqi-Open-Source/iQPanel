[Unit]
Description=iQPanel privileged Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/iqpanel
Environment=PANEL_DATA_ROOT=/var/lib/iqpanel
Environment=PANEL_SITES_ROOT=/var/www/sites
Environment=PANEL_AGENT_SOCKET=/run/iqpanel-agent.sock
Environment=PANEL_AGENT_LISTEN_PORT=4174
Environment=PANEL_AGENT_LISTEN_HOST=127.0.0.1
EnvironmentFile=/etc/panel-agent/env
ExecStart=/usr/bin/node /opt/iqpanel/agent-daemon.js
Restart=on-failure

[Install]
WantedBy=multi-user.target
