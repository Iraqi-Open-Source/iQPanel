[Unit]
Description=iQPanel Root Agent
After=network.target
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/iqpanel
EnvironmentFile=/etc/panel-agent/env
ExecStart=/usr/bin/node /opt/iqpanel/agent/main.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iqpanel-agent

[Install]
WantedBy=multi-user.target
