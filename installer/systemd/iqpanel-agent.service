[Unit]
Description=iQPanel Root Agent
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/iqpanel
EnvironmentFile=/etc/panel-agent/env
ExecStartPre=+/bin/chown root:panel /run/iqpanel-agent.sock 2>/dev/null || true
ExecStart=/usr/bin/node /opt/iqpanel/agent/main.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iqpanel-agent

[Install]
WantedBy=multi-user.target
