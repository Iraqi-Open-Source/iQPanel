docRoot                   {{site_root}}
vhDomain                  {{server_name}}
vhAliases                 www.{{server_name}}
enableGzip                1
indexFiles                index.php,index.html
errorlog {{site_path}}/logs/openlitespeed-error.log {
  useServer               1
}
accesslog {{site_path}}/logs/openlitespeed-access.log {
  useServer               0
}
context / {
  location                {{site_root}}
  allowBrowse             1
  indexFiles              index.php,index.html
  rewrite  {
    enable                1
    rewriteFile            {{site_root}}/.htaccess
  }
}
